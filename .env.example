# --- News sources -----------------------------------------------------------
# NewsAPI.org key (https://newsapi.org). The repo ships with a public demo key
# but you should use your own for production.
NEWS_API_KEY=0da246dfaec44a3da7c3a9c238a76bae

# --- GenLayer multi-network setup -------------------------------------------
# The frontend lets users switch between networks at runtime. A network is
# enabled in the picker only when its ORACLE_ADDR_* var below is set.
#
# Hex private key for a funded account. The same key works on every network
# but you need to fund the address on each one separately.
#   Bradbury faucet: https://testnet-faucet.genlayer.foundation/
#   Studio faucet : https://studio.genlayer.com/  (use the in-Studio funder)
GENLAYER_PRIVATE_KEY=0x_your_funded_private_key_here

# NewsOracle contract addresses per network. Deploy with:
#   $env:GENLAYER_NETWORK="testnetBradbury"; node scripts/gl_deploy.mjs
#   $env:GENLAYER_NETWORK="studionet";       node scripts/gl_deploy.mjs
ORACLE_ADDR_BRADBURY=0xbeeC2E89bf9572F6aE3E504f61f79Fb80dF7A875
ORACLE_ADDR_STUDIONET=
# ORACLE_ADDR_ASIMOV=

# Default network when no per-request override is supplied (front-end picker
# overrides this at runtime). Accepts SDK chain keys: testnetBradbury,
# studionet, testnetAsimov, localnet.
GENLAYER_NETWORK=testnetBradbury

# Legacy alias for ORACLE_ADDR_BRADBURY — still honoured but new deployments
# should use ORACLE_ADDR_* instead.
# NEWS_ORACLE_ADDRESS=

# Optional: path to the Node executable used to run scripts/gl_analyse.mjs
# (only override if `node` is not on your PATH).
# GL_NODE_BIN=node


# --- Server -----------------------------------------------------------------
PORT=5002
