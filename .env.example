# --- News sources -----------------------------------------------------------
# NewsAPI.org key (https://newsapi.org). The repo ships with a public demo key
# but you should use your own for production.
NEWS_API_KEY=0da246dfaec44a3da7c3a9c238a76bae

# --- GenLayer mode (Testnet Bradbury, preferred) ----------------------------
# Address of the deployed NewsOracle Intelligent Contract on Bradbury.
NEWS_ORACLE_ADDRESS=0xbeeC2E89bf9572F6aE3E504f61f79Fb80dF7A875

# Hex private key for a Bradbury-funded account. Get GEN from the faucet:
#   https://testnet-faucet.genlayer.foundation/
GENLAYER_PRIVATE_KEY=0x_your_funded_bradbury_private_key_here

# Network name passed to genlayer-js. Bradbury is the default; switch to
# `testnetAsimov`, `studionet`, or `localnet` if you prefer.
GENLAYER_NETWORK=testnetBradbury

# Optional: path to the Node executable used to run scripts/gl_analyse.mjs
# (only override if `node` is not on your PATH).
# GL_NODE_BIN=node


# --- Server -----------------------------------------------------------------
PORT=5002
